# Copiar a .env (ignorado por git) y elegir una contraseña local.
# Solo para desarrollo: en Azure estos valores son variables de entorno del App Service.

# PostgreSQL de docker-compose.yml
POSTGRES_DB=ofertas_postulaciones
POSTGRES_USER=ofertas
POSTGRES_PASSWORD=cambiar-esta-contraseña
# Puerto en esta máquina. Cambiarlo (y el de DB_URL) si el 5432 ya está ocupado.
POSTGRES_PORT=5432

# Lo que lee la aplicación (application.yml)
DB_URL=jdbc:postgresql://localhost:5432/ofertas_postulaciones
DB_USER=ofertas
DB_PASSWORD=cambiar-esta-contraseña
