{
  "info": {
    "name": "CVExpert - Ofertas y Postulaciones",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Una prueba por ruta del servicio de Ofertas y Postulaciones (docs/openapi.yaml). Las solicitudes van en orden: crean sus propios datos y los limpian al final.\n\nEn local, baseUrl es http://localhost:8080 y los encabezados X-User-* los pone la colección. A través de APIM, baseUrl es la URL de APIM con /api/v1, y APIM reemplaza esos encabezados con la identidad del token de Google."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "userId",
      "value": "postman-usuario"
    },
    {
      "key": "userEmail",
      "value": "postman@example.com"
    },
    {
      "key": "jobId",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "Salud del servicio",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 y UP\", () => {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql(\"UP\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-User-Id",
                "value": "{{userId}}"
              },
              {
                "key": "X-User-Email",
                "value": "{{userEmail}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "actuator",
                "health"
              ]
            }
          }
        }
      ]
    },
